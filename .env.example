# ============================================================================
# Business Opportunity Scanner — configuración
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# ============================================================================

# --- Base de datos (PostgreSQL) -------------------------------------------
# Local (instalación nativa o docker compose):
DATABASE_URL="postgresql://bos:CAMBIA_ESTA_PASSWORD@localhost:5432/bos?schema=public"
# Solo para docker compose (contraseña del usuario "bos" del contenedor de PostgreSQL)
POSTGRES_PASSWORD="CAMBIA_ESTA_PASSWORD"

# --- Autenticación ----------------------------------------------------------
# Obligatoria en producción. En desarrollo, si no se define, la app queda abierta
# (solo accesible desde tu PC) y muestra un aviso.
# Genera el hash con:  npm run auth:hash -- "tu-contraseña"
AUTH_USERNAME="admin"
AUTH_PASSWORD_HASH=""
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Duración de la sesión en días
AUTH_SESSION_DAYS="30"

# --- Proveedor de negocios --------------------------------------------------
# Google Places API (New). Activa "Places API (New)" en Google Cloud y restringe la clave.
GOOGLE_MAPS_API_KEY=""
# Pide reseñas (máx. 5 por negocio) en la misma llamada de Text Search (SKU Enterprise + Atmosphere).
GOOGLE_PLACES_FETCH_REVIEWS="true"
# Límite de llamadas a Google por escaneo (control de coste).
GOOGLE_MAX_REQUESTS_PER_SCAN="60"

# Proveedor por defecto: google | osm   (si no hay clave de Google se usa osm)
DEFAULT_PLACE_PROVIDER=""

# OpenStreetMap (gratuito, sin clave). Respeta sus políticas de uso.
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org"

# --- Buscador (opcional) ----------------------------------------------------
# Se usa para buscar la web oficial de negocios cuya ficha no enlaza ninguna.
# none | brave
SEARCH_PROVIDER="none"
SEARCH_API_KEY=""

# --- Crawler / análisis web -------------------------------------------------
# Contacto que se añade al User-Agent (URL o email de tu empresa). Recomendado.
CRAWLER_CONTACT=""
CRAWLER_TIMEOUT_MS="15000"
CRAWLER_MAX_BYTES="3000000"
CRAWLER_MAX_PAGES="6"
CRAWLER_MAX_LINK_CHECKS="25"
RESPECT_ROBOTS_TXT="true"
# Renderizado con navegador (Playwright) para webs que requieren JavaScript. Desactivado por defecto.
# Requiere: npx playwright install chromium
ENABLE_BROWSER_RENDERING="false"

# --- Worker de jobs ---------------------------------------------------------
# inprocess = el worker corre dentro del servidor Next.js (un solo proceso)
# external  = lanzas `npm run worker` aparte (recomendado en producción con varios servidores)
# off       = no procesa jobs
WORKER_MODE="inprocess"
WORKER_CONCURRENCY="3"

# --- Notificaciones push (recordatorios de seguimiento en el móvil) --------
# Genera las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"

# --- Retención de datos de proveedores --------------------------------------
# Días tras los cuales `npm run data:purge-provider` borra datos cacheados del proveedor
# (se conserva el Place ID). Revisa las condiciones de Google Maps Platform.
PROVIDER_DATA_TTL_DAYS="30"

# --- Estimación de costes (USD por 1000 llamadas) --------------------------
# Valores orientativos. Comprueba los precios vigentes en tu consola de Google Cloud.
PRICE_GOOGLE_TEXT_SEARCH_PER_1000="35"
PRICE_GOOGLE_TEXT_SEARCH_WITH_REVIEWS_PER_1000="40"
PRICE_GOOGLE_GEOCODE_PER_1000="32"
PRICE_SEARCH_PER_1000="5"
